{
  "appId": "com.aactp.retrospective",
  "appName": "AACTP项目复盘",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#2c3e50",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "backgroundColor": "#2c3e50",
      "style": "LIGHT"
    }
  }
}
